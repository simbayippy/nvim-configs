// Place your key bindings in this file to override the defaultsauto[]
[
  // curosr thing
  // {
  //     "key": "cmd+i",
  //     "command": "composerMode.agent"
  // },
  // idk
  // {
  //   "key": "cmd+r",
  //   "command": "workbench.action.debug.start",
  //   "when": "debuggersAvailable && debugState == 'inactive'"
  // },
  
  // so that when i navigate in file directory tree it enters the file instead of trying to rename
  {
    "key": "enter",
    "command": "list.select",
    "when": "filesExplorerFocus && !inputFocus"
  },

  // so when I press escape (while in chat) it goes back to editor
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "auxiliaryBarFocus"
  },

  // so when i press escape while in terminal goes back to editor
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },

  // === NAVIGATION KEYBINDINGS ===
  // Ctrl+H: Move left OR focus sidebar OR move from chat to editor
  {
    "key": "ctrl+h",
    "command": "workbench.action.focusLeftGroup",
    "when": "editorTextFocus && vim.active && vim.mode != 'Insert' && !chatInputFocus"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.focusSideBar",
    "when": "editorFocus && activeEditorGroupIndex == 1 && !chatInputFocus"
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "auxiliaryBarFocus"
  },

  // Ctrl+L: Move right OR focus chat panel
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusRightGroup",
    "when": "editorTextFocus && vim.active && vim.mode != 'Insert' && !chatInputFocus && !activeEditorGroupLast"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.chat.icube.open",
    "when": "editorTextFocus && vim.active && vim.mode != 'Insert' && !chatInputFocus && activeEditorGroupLast"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusFirstEditorGroup",
    "when": "sideBarFocus || filesExplorerFocus || searchViewletFocus",
  },

  // Ctrl+J: Move down OR focus terminal
  {
    "key": "ctrl+j",
    "command": "workbench.action.focusBelowGroup",
    "when": "editorTextFocus && vim.active && vim.mode != 'Insert' && !chatInputFocus"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.terminal.focus",
    "when": "editorTextFocus && terminalViewShowing && vim.active && vim.mode != 'Insert' && !terminalFocus && !editorGroupsBelow && !chatInputFocus"
  },

  // Ctrl+K: Move up OR focus editor from terminal
  {
    "key": "ctrl+k",
    "command": "workbench.action.focusAboveGroup",
    "when": "editorFocus && vim.active && vim.mode != 'Insert' && !chatInputFocus"
  },
  // {
  //   "key": "ctrl+k",
  //   "command": "workbench.action.focusActiveEditorGroup",
  //   "when": "terminalFocus"
  // },

  /**
   * Removed or otherwise
   */
  {
    "key": "cmd+t",
    "command": "workbench.action.togglePanel"
  },

  /**
   * Tab Navigation
   */
  {
    "key": "alt+cmd+l",
    "command": "workbench.action.nextEditor",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+cmd+h",
    "command": "workbench.action.previousEditor",
    "when": "editorTextFocus"
  },

  // AUTO ADDED WHEN MANUALLY EDITING KEYBOARD SHORTCUTS
  {
    "key": "cmd+k",
    "command": "icube.inlineChat.start",
    "when": "icube.inlineChatHasProvider && icubeConfigEnableInlineChat && !editorReadonly",
    "isAIItem": true
  },
  {
    "key": "cmd+i",
    "command": "-icube.inlineChat.start",
    "when": "icube.inlineChatHasProvider && icubeConfigEnableInlineChat && !editorReadonly"
  },
  {
    "key": "cmd+k",
    "command": "inlineChat.startWithCurrentLine",
    "when": "inlineChatHasProvider && inlineChatShowingHint && !editorReadonly && !inlineChatVisible"
  },
  {
    "key": "cmd+i",
    "command": "-inlineChat.startWithCurrentLine",
    "when": "inlineChatHasProvider && inlineChatShowingHint && !editorReadonly && !inlineChatVisible"
  },
  {
    "key": "cmd+k",
    "command": "inlineChat2.stop",
    "when": "inlineChatHasEditsAgent && inlineChatVisible && chatEdits.requestCount == '0'",
    "isAIItem": false
  },
  {
    "key": "cmd+i",
    "command": "-inlineChat2.stop",
    "when": "inlineChatHasEditsAgent && inlineChatVisible && chatEdits.requestCount == '0'"
  },
  {
    "key": "cmd+k",
    "command": "workbench.action.terminal.chat.start",
    "when": "terminalChatAgentRegistered && terminalFocusInAny && terminalHasBeenCreated || terminalChatAgentRegistered && terminalFocusInAny && terminalProcessSupported"
  },
  {
    "key": "cmd+i",
    "command": "-workbench.action.terminal.chat.start",
    "when": "terminalChatAgentRegistered && terminalFocusInAny && terminalHasBeenCreated || terminalChatAgentRegistered && terminalFocusInAny && terminalProcessSupported"
  },
  {
    "key": "cmd+k",
    "command": "inlineChat2.reveal",
    "when": "inlineChatHasEditsAgent && !chatEdits.isGlobalEditingSession && chatEdits.requestCount >= 1"
  },
  {
    "key": "cmd+i",
    "command": "-inlineChat2.reveal",
    "when": "inlineChatHasEditsAgent && !chatEdits.isGlobalEditingSession && chatEdits.requestCount >= 1"
  },
  {
    "key": "cmd+backspace",
    "command": "workbench.action.terminal.clear",
    "when": "terminalFocus && terminalHasBeenCreated && !accessibilityModeEnabled || terminalFocus && terminalProcessSupported && !accessibilityModeEnabled || accessibilityModeEnabled && accessibleViewIsShown && terminalHasBeenCreated && accessibleViewCurrentProviderId == 'terminal' || accessibilityModeEnabled && accessibleViewIsShown && terminalProcessSupported && accessibleViewCurrentProviderId == 'terminal'"
  },
  {
    "key": "cmd+k",
    "command": "-workbench.action.terminal.clear",
    "when": "terminalFocus && terminalHasBeenCreated && !accessibilityModeEnabled || terminalFocus && terminalProcessSupported && !accessibilityModeEnabled || accessibilityModeEnabled && accessibleViewIsShown && terminalHasBeenCreated && accessibleViewCurrentProviderId == 'terminal' || accessibilityModeEnabled && accessibleViewIsShown && terminalProcessSupported && accessibleViewCurrentProviderId == 'terminal'"
  },
  {
    "key": "shift+cmd+t",
    "command": "workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  },
  {
    "key": "ctrl+shift+`",
    "command": "-workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile"
  },
  {
    "key": "alt+cmd+j",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
    "isAIItem": false
  },
  {
    "key": "alt+cmd+down",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
    "isAIItem": false
  },
  {
    "key": "alt+cmd+uift+cmd+]",
    "command": "-workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
  },
  {
    "key": "alt+cmd+k",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
    "isAIItem": false
  },
  {
    "key": "alt+cmd+up",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
    "isAIItem": false
  },
  {
    "key": "shift+cmd+[",
    "command": "-workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
  },
  {
    "key": "alt+cmd+l",
    "command": "workbench.action.terminal.focusNextPane",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported",
    "isAIItem": false
  },
  {
    "key": "alt+cmd+right",
    "command": "workbench.action.terminal.focusNextPane",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported",
    "isAIItem": false
  },
  {
    "key": "alt+cmd+right",
    "command": "-workbench.action.terminal.focusNextPane",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
  },
  {
    "key": "alt+cmd+h",
    "command": "workbench.action.terminal.focusPreviousPane",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported",
    "isAIItem": false
  },
  {
    "key": "alt+cmd+left",
    "command": "workbench.action.terminal.focusPreviousPane",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported",
    "isAIItem": false
  },
  {
    "key": "alt+cmd+left",
    "command": "-workbench.action.terminal.focusPreviousPane",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
  },
  {
    "key": "shift+cmd+l",
    "command": "workbench.action.icube.aiChatSidebar.createNewSession",
    "when": "AI_AGENT_FOCUS_VIEW_SHOW && isUserLogined",
    "isAIItem": false
  },
  {
    "key": "cmd+o",
    "command": "editor.toggleFold",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "cmd+k cmd+l",
    "command": "-editor.toggleFold",
    "when": "editorTextFocus && foldingEnabled"
  },
  {
    "key": "shift+cmd+n",
    "command": "workbench.action.icube.aiChatSidebar.createNewSession",
    "when": "AI_AGENT_FOCUS_VIEW_SHOW && isUserLogined"
  },
  {
    "key": "cmd+n",
    "command": "-workbench.action.files.newUntitledFile"
  },
  {
    "key": "ctrl+k",
    "command": "-deleteAllRight",
    "when": "textInputFocus && !editorReadonly"
  },
  {
    "key": "ctrl+j",
    "command": "selectNextCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevCodeAction",
    "when": "codeActionMenuVisible"
  },
  {
    "key": "ctrl+w",
    "command": "workbench.action.switchWindow",
    "when": "vim.active && vim.mode != 'Insert'"
  },
  {
    "key": "ctrl+w",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus"
  },
  {
    "key": "escape",
    "command": "closeFindWidget",
    "when": "vim.active && vim.mode == 'Normal' && findWidgetVisible"
  },
  {
    "key": "cmd+l",
    "command": "workbench.action.chat.icube.open",
    "isAIItem": true
  },
  {
    "key": "cmd+u",
    "command": "-workbench.action.chat.icube.open"
  },
]
