{
  "[python]": {
    "editor.formatOnType": true
  },
  "editor.tabSize": 2,
  "editor.linkedEditing": true,
  // "typescript.updateImportsOnFileMove.enabled": "always",
  // "[typescript]": {
  //   "editor.defaultFormatter": "esbenp.prettier-vscode",
  //   "editor.formatOnPaste": true,
  //   "editor.formatOnSave": true
  // },
  // "editor.defaultFormatter": "esbenp.prettier-vscode",
  "javascript.updateImportsOnFileMove.enabled": "always",
  // "editor.formatOnSave": true,
  "editor.fontFamily": "MesloLGS Nerd Font Mono",
  "cursor.cpp.disabledLanguages": [
    "plaintext",
    "markdown",
    "scminput"
  ],
  "find-it-faster.general.useTerminalInEditor": true,
  "find-it-faster.general.killTerminalAfterUse": true,
  "vim.leader": "<space>",
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "editor.lineNumbers": "relative",
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-h>": false,
    "<C-j>": false,
    "<C-k>": false,
    "<C-l>": false,
  },
  "vim.visualModeKeyBindingsNonRecursive": [
    // allows indenting in visual mode
    {
      "before": [
        "<Tab>"
      ],
      "commands": [
        "editor.action.indentLines"
      ]
    },
    {
      "before": [
        "<S-Tab>"
      ],
      "commands": [
        "editor.action.outdentLines"
      ]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    // // allowing indenting when in vim mode
    // {
    //   "before": ["<Tab>"],
    //   "commands": ["editor.action.indentLines"]
    // },
    // {
    //   "before": ["<S-Tab>"],
    //   "commands": ["editor.action.outdentLines"]
    // },
    // custom panel stuff
    {
      "before": [
        "<leader>",
        "s",
        "v"
      ],
      "commands": [
        "workbench.action.splitEditorRight"
      ]
    },
    {
      "before": [
        "<leader>",
        "s",
        "h"
      ],
      "commands": [
        "workbench.action.splitEditorDown"
      ]
    },
    {
      "before": [
        "<leader>",
        "s",
        "e"
      ],
      "commands": [
        "workbench.action.evenEditorWidths"
      ]
    },
    {
      "before": [
        "<leader>",
        "s",
        "x"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "f"
      ],
      "commands": [
        "find-it-faster.findFiles"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "f",
        "r"
      ],
      "commands": [
        "workbench.action.openRecent"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "f",
        "s"
      ],
      "commands": [
        "find-it-faster.findWithinFiles"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "f",
        "c"
      ],
      "commands": [
        "editor.action.addSelectionToNextFindMatch",
        "workbench.action.findInFiles"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "e",
        "e"
      ],
      "commands": [
        "workbench.action.toggleSidebarVisibility"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "e",
        "f"
      ],
      "commands": [
        "workbench.files.action.showActiveFileInExplorer"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "e",
        "c"
      ],
      "commands": [
        "workbench.files.action.collapseExplorerFolders"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "e",
        "r"
      ],
      "commands": [
        "workbench.files.action.refreshFilesExplorer"
      ],
      "silent": true
    },
    {
      "before": [
        "<leader>",
        "t",
        "t"
      ],
      "commands": [
        "workbench.action.togglePanel"
      ]
    },
    {
      "before": [
        "<A-Up>"
      ],
      "commands": [
        "editor.action.moveLinesUpAction"
      ]
    },
    {
      "before": [
        "<A-Down>"
      ],
      "commands": [
        "editor.action.moveLinesDownAction"
      ]
    },
    {
      "before": [
        "<leader>",
        "n",
        "h"
      ],
      "commands": [
        ":nohl"
      ],
      "silent": true
    },
    {
      "before": [
        "g",
        "r"
      ],
      "commands": [
        {
          "command": "editor.action.goToReferences"
        }
      ]
    },
  ],
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "k"
      ],
      "after": [
        "<Esc>"
      ]
    },
    {
      "before": [
        "<A-Up>"
      ],
      "commands": [
        "editor.action.moveLinesUpAction"
      ],
      "silent": true
    },
    {
      "before": [
        "<A-Down>"
      ],
      "commands": [
        "editor.action.moveLinesDownAction"
      ],
      "silent": true
    },
  ],
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "editor.semanticTokenColorCustomizations": {
    // comment out to apply specifically to cursor dark only 
    // "[Cursor Dark]": {
    "rules": {
      "namespace:go": "#A5C261",
      "module:go": "#A5C261",
      "package:go": "#A5C261"
    }
    // }
  },
  "workbench.colorTheme": "Cursor Dark",
  "AI.toolcall.confirmMode": "autoRun",
  "terminal.integrated.allowChords": false
}
